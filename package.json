{
  "name": "typescript-testing",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:integration": "playwright test tests/integration",
    "test:integration:apple": "TEST_RUNTIME=apple-containers KAFKA_BROKERS=${KAFKA_BROKERS:-127.0.0.1:${KAFKA_PORT:-9092}} playwright test tests/integration",
    "test:ui": "playwright test tests/ui",
    "test:ui:apple": "TEST_RUNTIME=apple-containers UI_APP_URL=${UI_APP_URL:-http://127.0.0.1:${JUICE_SHOP_PORT:-3000}} playwright test tests/ui",
    "containers:apple:start": "sh scripts/apple-containers/start.sh",
    "containers:apple:stop": "sh scripts/apple-containers/stop.sh",
    "containers:apple:start:ui": "sh scripts/apple-containers/start-ui.sh",
    "containers:apple:stop:ui": "sh scripts/apple-containers/stop-ui.sh",
    "test:headed": "playwright test --headed"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "TypeScript Playwright automation project backed by Testcontainers for PostgreSQL and Kafka.",
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testcontainers/kafka": "^12.0.4",
    "@testcontainers/postgresql": "^12.0.4",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "testcontainers": "^12.0.4",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@confluentinc/kafka-javascript": "^1.10.0",
    "pg": "^8.22.0"
  }
}
